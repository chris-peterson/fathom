#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml>=6"]
# ///
"""fathom: one record of facts, rendered for each reader.

A record is a directory holding record.jsonl: its rows, one JSON object per
line, append-only. Row 0 holds the record's kind and title; a retitle adds a row
like it. Every other row is a fact. The record's version is the seq of its last
row; reading as of version N gives, for each key, its latest row with seq <= N.

The lede is the record's bottom line up front: one fact of type lede, under the
key `lede`, revised as a new row whenever the facts move it. It is inferred,
every key in its rests-on is a current fact, and every number in its statement
is one those facts hold. show leads with it and calls it stale when a fact it
rests on has changed or been retracted since; each view opens with it.

Views live apart from the facts, in the record's views/ directory: each saved
view at views/<name>/v<N>.html, and views/renders.jsonl logging every save with
the inputs it came from (record version, brief and its digest, style and its
digest, format, visibility) and every publish with where it went. Deleting
views/ loses no fact.

Kinds are looked up by name in each directory of FATHOM_KINDS
(os.pathsep-separated), then in the plugin's kinds/. A kind is a directory with
schema.yml, briefs/*.md, and optionally framing/*.md and sources.md. A kind
whose schema.yml names `extends: <kind>` inherits that kind's fact types,
briefs, framing rules, and sources, and replaces any it redefines.

A record argument that is a bare kebab-case name (checkout-outage), or two
qualified as <route>/<tack> (auth-rewrite/t3), names a record under .fathom/ at
the root of the git repo holding the working directory, or under ./.fathom
outside a repo; anything else is a path.

Every write notes the Claude session it came from (CLAUDE_CODE_SESSION_ID) in a
ledger under $FATHOM_STATE, else $XDG_STATE_HOME/fathom, else
~/.local/state/fathom, so `touched` can list the records a session wrote and a
compaction pass leaves every other record alone. init
writes .fathom/.gitignore holding `*`, so a record stays out of commits until
someone adds it on purpose (git add -f, or deleting that file).

A row may carry a visibility, the levels a GitLab project uses: public (anyone),
internal (anyone in the organization), or private (the people on the work). A
row without one takes its key's previous visibility. A view stamps the
visibility of where it is published, and check fails any cited row narrower
than that.

Exit codes:
  0  done; for check, the view passed
  1  bad input, an invalid row, or a missing record, kind, or brief
  2  usage
  3  check found failures; each is printed with its text
"""
import argparse
import fcntl
from contextlib import contextmanager
import hashlib
import json
import os
import shutil
import re
import subprocess
import sys
import time
from datetime import date, datetime, timezone
from html.parser import HTMLParser
from pathlib import Path

import yaml

PLUGIN_ROOT = Path(os.environ.get("CLAUDE_PLUGIN_ROOT") or Path(__file__).resolve().parent.parent)
CERTAINTY = ("measured", "observed", "inferred")
VISIBILITY = ("public", "internal", "private")
KEY = re.compile(r"^[a-z0-9][a-z0-9-]*$")
NAME = re.compile(r"^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$")  # a bare record name: <name> or <route>/<tack>
MARKUP = re.compile(r"<[a-zA-Z/!?]")
DIGITS = re.compile(r"\d+")
THOUSANDS = re.compile(r"(?<=\d),(?=\d{3}\b)")
FIELD_TYPES = ("text", "code", "number", "datetime", "date", "url", "enum", "list", "map")
LEDE = "lede"  # the record's bottom line: both its fact type and its one key
# Why a fact was retracted. A retraction without one is `wrong`, the original meaning.
REASONS = ("wrong", "duplicate", "irrelevant")
# How one fact bears on others, recorded on the newer fact, which is the one that knows about the older.
RELATIONS = ("supersedes", "contradicts", "corroborates")
INVERSE = {"supersedes": "superseded by", "contradicts": "contradicted by", "corroborates": "corroborated by"}


def fail(message):
    sys.exit(f"fathom: {message}")


def dump(data):
    return yaml.safe_dump(data, sort_keys=False, allow_unicode=True, width=100)


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def read_jsonl(path):
    rows = []
    for n, line in enumerate(path.read_text().splitlines(), 1):
        if line.strip():
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError as e:
                fail(f"{path}:{n} is not a JSON row: {e}")
    return rows


def append_jsonl(path, rows):
    """One write per call, so an addition lands whole."""
    with path.open("a") as out:
        out.write("".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows))


def digest(text):
    return "sha256:" + hashlib.sha256(text.encode()).hexdigest()[:12]


def as_text(value):
    """YAML reads an unquoted timestamp as a datetime; the record stores the text."""
    if isinstance(value, dict):
        return {k: as_text(v) for k, v in value.items()}
    if isinstance(value, list):
        return [as_text(v) for v in value]
    if isinstance(value, (datetime, date)):
        return value.isoformat()
    return value



def kind_dirs(name):
    path = [Path(p) for p in os.environ.get("FATHOM_KINDS", "").split(os.pathsep) if p]
    path.append(PLUGIN_ROOT / "kinds")
    return [d / name for d in path if (d / name / "schema.yml").is_file()]


def kind_chain(name):
    """The kind's directory, then its base's, and so on."""
    chain, seen = [], []
    while name:
        if name in seen:
            fail(f"kind {name!r} extends itself through {' -> '.join(seen)}")
        seen.append(name)
        found = kind_dirs(name)
        if not found:
            fail(f"no kind named {name!r} in FATHOM_KINDS or {PLUGIN_ROOT / 'kinds'}")
        schema = yaml.safe_load((found[0] / "schema.yml").read_text()) or {}
        enum_values_are_text(name, schema)
        chain.append((name, found[0], schema))
        name = schema.get("extends")
    return chain


def enum_values_are_text(kind, schema):
    """Refuse a kind whose enum lists a value YAML didn't read as text.

    A bare yes, no, on, or off is a boolean to YAML, so `values: [yes, no]`
    loads as [True, False]: no row can match it, and reporting the mismatch
    crashed instead of naming the field.
    """
    for ftype, spec in (schema.get("facts") or {}).items():
        for field, f in ((spec or {}).get("fields") or {}).items():
            bad = [v for v in (f or {}).get("values") or [] if not isinstance(v, str)]
            if bad:
                fail(f"kind {kind!r}: {ftype}.{field} lists enum values that aren't text "
                     f"({', '.join(map(repr, bad))}); YAML reads a bare yes, no, on, or off "
                     f"as a boolean, so quote them")


def fact_types(chain):
    types = {}
    for _, _, schema in reversed(chain):
        types.update(schema.get("facts") or {})
    return types


def find_in_chain(chain, sub, name, start=0):
    for i, (kind, d, _) in enumerate(chain[start:], start):
        f = d / sub / f"{name}.md"
        if f.is_file():
            return i, kind, f
    return None, None, None


def listed(chain, sub):
    names = {}
    for kind, d, _ in reversed(chain):
        for f in sorted((d / sub).glob("*.md")) if (d / sub).is_dir() else []:
            names[f.stem] = kind
    return names


class BriefError(Exception):
    pass


def parse_front_matter(path):
    """A brief's front matter and body; raises BriefError naming the file, line, and column."""
    text = path.read_text()
    if not text.startswith("---\n"):
        return {}, text
    head, _, body = text[4:].partition("\n---\n")
    try:
        meta = yaml.safe_load(head) or {}
    except yaml.YAMLError as e:
        mark = getattr(e, "problem_mark", None)
        where = f" at line {mark.line + 2}, column {mark.column + 1}" if mark else ""  # +2: the opening --- is line 1
        why = getattr(e, "problem", None) or str(e).splitlines()[0]
        hint = "; quote a value that holds ': '" if "mapping values" in str(why) else ""
        raise BriefError(f"{path}: front matter is not valid YAML{where}: {why}{hint}") from None
    if not isinstance(meta, dict):
        raise BriefError(f"{path}: front matter must be a mapping of fields, not {type(meta).__name__}")
    return meta, body


def front_matter(path):
    try:
        return parse_front_matter(path)
    except BriefError as e:
        fail(str(e))



def records_root():
    """.fathom/ at the root of the git repo holding the working directory, else ./.fathom."""
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        top = ""
    return Path(top or ".") / ".fathom"


def record_dir(arg):
    """A bare name is a record under records_root(); anything else is a path.

    A bare name is kebab-case, or two of them qualified as <route>/<tack>, the
    way tack names a unit of work, so each tack keeps its own record.
    """
    return records_root() / arg if NAME.match(arg) else Path(arg)


def state_dir():
    return Path(os.environ.get("FATHOM_STATE") or Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "fathom")


def ledger_path(session):
    return state_dir() / "sessions" / f"{session}.jsonl"


def log_timing(command, started, status):
    """One line per CLI run, so `fathom metrics` can say what the CLI costs in time."""
    try:
        path = state_dir() / "timings.jsonl"
        path.parent.mkdir(parents=True, exist_ok=True)
        append_jsonl(path, [{"at": now(), "command": command, "ms": round((time.monotonic() - started) * 1000),
                             "status": status, "session": os.environ.get("CLAUDE_CODE_SESSION_ID")}])
    except OSError:
        pass


def note_session(record, command):
    """Log which records this Claude session wrote, so its compaction pass touches only those."""
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not session or not re.fullmatch(r"[A-Za-z0-9-]+", session):
        return
    path = ledger_path(session)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        append_jsonl(path, [{"record": str(record.dir.resolve()), "at": now(), "command": command, "version": record.version}])
    except OSError:
        pass  # the ledger is a convenience; a write it can't log is still written


class Record:
    def __init__(self, directory):
        self.dir = record_dir(str(directory))
        self.path = self.dir / "record.jsonl"
        if not self.path.is_file():
            fail(f"no record at {self.dir} (missing record.jsonl); start one with `fathom init`")
        self.load()
        self._lock, self._depth = None, 0
        self.views = self.dir / "views"
        self.chain = kind_chain(self.meta()["kind"])
        self.types = fact_types(self.chain)

    def load(self):
        self.all = read_jsonl(self.path)
        if not self.all or self.all[0].get("seq") != 0 or not (self.all[0].get("record") or {}).get("kind"):
            fail(f"{self.path} does not open with row 0 naming the record's kind")
        self.rows = [r for r in self.all if "record" not in r]

    @contextmanager
    def writing(self):
        """Hold the record's write lock and read it fresh, so concurrent writers can't number rows from one version.

        Re-entrant within a process: a command that reads the facts it will
        rewrite (classify) takes the lock first, and append inside it nests.
        """
        if self._depth == 0:
            self._lock = self.path.open("a")
            fcntl.flock(self._lock, fcntl.LOCK_EX)
            self.load()
        self._depth += 1
        try:
            yield self
        finally:
            self._depth -= 1
            if self._depth == 0:
                fcntl.flock(self._lock, fcntl.LOCK_UN)
                self._lock.close()
                self._lock = None

    @property
    def version(self):
        return self.all[-1]["seq"]

    def meta(self, version=None):
        """The record's kind and title as of a version: row 0, then each retitle."""
        merged = {}
        for row in self.all:
            if "record" in row and (version is None or row["seq"] <= version):
                merged.update(row["record"])
        return merged

    def as_of(self, version=None):
        version = self.version if version is None else version
        if version > self.version:
            fail(f"version {version} is past the record's latest, {self.version}")
        latest = {}
        for row in self.rows:
            if row["seq"] <= version:
                latest[row["key"]] = row
        return {k: r for k, r in latest.items() if not r.get("retracted")}

    def stamp(self, rows):
        """Number rows from the next version, append them, and return them."""
        seq, at, out = self.version, now(), []
        for row in rows:
            seq += 1
            out.append({"seq": seq, **{k: v for k, v in row.items() if k != "recorded"}, "recorded": at}
                       if "record" in row else {"seq": seq, "key": row["key"], "type": row["type"], "recorded": at,
                                                **{k: row[k] for k in ("certainty", "basis", "fields", "relates", "retracted", "reason", "visibility") if k in row}})
        append_jsonl(self.path, out)
        self.all += out
        self.rows += [r for r in out if "record" not in r]
        note_session(self, sys.argv[1] if len(sys.argv) > 1 else "?")
        return out

    def validate(self, row, pending):
        errors = []
        unknown = set(row) - {"key", "type", "certainty", "basis", "fields", "relates", "retracted", "reason", "visibility"}
        if unknown:
            errors.append(f"unknown row properties: {', '.join(sorted(unknown))}")
        key = row.get("key")
        if not isinstance(key, str) or not KEY.match(key):
            errors.append(f"key {key!r} must be lowercase letters, digits, and hyphens")
        ftype = row.get("type")
        spec = self.types.get(ftype)
        if spec is None:
            errors.append(f"type {ftype!r} is not in kind {self.meta()['kind']!r} (has: {', '.join(sorted(self.types))})")
        earlier = next((r for r in reversed(pending + self.rows) if r["key"] == key), None)
        if earlier and earlier["type"] != ftype:
            errors.append(f"key {key!r} is a {earlier['type']}; a key keeps its type")
        if "visibility" in row and row["visibility"] not in VISIBILITY:
            errors.append(f"visibility must be one of {', '.join(VISIBILITY)}, widest first")
        if ftype == LEDE and key != LEDE:
            errors.append(f"a lede's key is {LEDE!r}: a record has one lede, revised as a new row of that key")
        elif key == LEDE and ftype != LEDE:
            errors.append(f"key {LEDE!r} is the record's lede; use type {LEDE!r}")
        if "reason" in row and not row.get("retracted"):
            errors.append("reason belongs on a retraction: why the fact was dropped")
        elif "reason" in row and row["reason"] not in REASONS:
            errors.append(f"reason must be one of {', '.join(REASONS)}")
        if "relates" in row and row.get("retracted"):
            errors.append("relates belongs on a fact, not a retraction")
        elif "relates" in row:
            errors += self.relation_errors(row, pending)
        if row.get("retracted"):
            if earlier is None:
                errors.append(f"cannot retract {key!r}: the record has no row for it")
            if not row.get("basis"):
                errors.append("a retraction needs a basis: why the fact no longer holds")
            return errors
        if row.get("certainty") not in CERTAINTY:
            errors.append(f"certainty must be one of {', '.join(CERTAINTY)}")
        if not isinstance(row.get("basis"), str) or not row["basis"].strip():
            errors.append("basis is required: the record or reasoning the fact rests on")
        elif MARKUP.search(row["basis"]):
            errors.append("basis holds markup; store text, and let views present it")
        fields = row.get("fields")
        if not isinstance(fields, dict):
            errors.append("fields must be an object")
        elif spec is not None:
            errors += field_errors(fields, spec.get("fields") or {})
            if ftype == LEDE and key == LEDE and not errors:
                errors += self.lede_errors(row, pending)
        return errors

    def current(self, pending):
        """The current facts with the rows of an addition in progress applied, in order."""
        current = self.as_of()
        for p in pending:
            if p.get("retracted"):
                current.pop(p["key"], None)
            else:
                current[p["key"]] = p
        return current

    def relation_errors(self, row, pending):
        relates = row["relates"]
        if not isinstance(relates, dict) or not all(isinstance(v, list) and all(isinstance(k, str) for k in v) for v in relates.values()):
            return ["relates must map a relation to a list of fact keys: {supersedes: [<key>, ...]}"]
        errors = [f"relation {r!r} is not one of {', '.join(RELATIONS)}" for r in relates if r not in RELATIONS]
        current = self.current(pending)
        for rel, keys in relates.items():
            for k in keys:
                if k == row.get("key") or k == LEDE:
                    errors.append(f"{rel} names {k!r}; a fact relates to other facts, and the lede to its rests-on")
                elif k not in current:
                    errors.append(f"{rel} names {k!r}, which is not a current fact of the record")
        return errors

    def lede_errors(self, row, pending):
        """A lede summarizes other facts, so it is inferred, rests on current facts, and holds only their numbers.

        Without the number rule, a view citing the lede would let the lede's own
        numbers vouch for themselves in `check`.
        """
        errors = []
        if not isinstance(row["fields"].get("statement"), str) or not isinstance(row["fields"].get("rests-on"), list):
            return [f"a lede needs a text `statement` and a `rests-on` list; kind {self.meta()['kind']!r} redefines "
                    f"the {LEDE!r} type without them"]
        if row["certainty"] != "inferred":
            errors.append("a lede is inferred: it summarizes the facts it rests on")
        current = self.current(pending)
        rests_on = row["fields"]["rests-on"]
        missing = [k for k in rests_on if k == LEDE or k not in current]
        if missing:
            errors.append(f"rests-on names {', '.join(map(repr, missing))}, which "
                          f"{'is' if len(missing) == 1 else 'are'} not a current fact of the record")
        held = set().union(*(row_runs(current[k]) for k in rests_on if k in current and k != LEDE))
        loose = sorted(digit_runs(row["fields"]["statement"]) - held)
        if loose:
            errors.append(f"statement has {', '.join(map(str, loose))}, which none of the facts it rests on holds; "
                          f"record the number as a fact and add it to rests-on")
        return errors

    def append(self, rows):
        with self.writing():
            self._append(rows)

    def _append(self, rows):
        pending, problems = [], []
        for i, row in enumerate(rows):
            errors = self.validate(row, pending)
            if errors:
                problems.append((row.get("key", f"row {i + 1}"), errors))
            else:
                pending.append(row)
        if problems:
            for key, errors in problems:
                for e in errors:
                    print(f"{key}: {e}", file=sys.stderr)
            fail(f"recorded nothing: {len(problems)} of {len(rows)} rows are invalid")
        for row in pending:
            earlier = next((r for r in reversed(self.rows) if r["key"] == row["key"]), None)
            if "visibility" not in row and not row.get("retracted") and earlier and earlier.get("visibility"):
                row["visibility"] = earlier["visibility"]
            if "relates" not in row and not row.get("retracted") and earlier and earlier.get("relates"):
                row["relates"] = earlier["relates"]  # a correction keeps its relations unless it restates them
        for stored in self.stamp(pending):
            note = " (retracted)" if stored.get("retracted") else f" ({stored['visibility']})" if stored.get("visibility") else ""
            print(f"v{stored['seq']} {stored['key']}{note}")


def field_errors(fields, spec):
    errors = []
    for name in set(fields) - set(spec):
        errors.append(f"field {name!r} is not in the schema (has: {', '.join(sorted(spec))})")
    for name, f in spec.items():
        if name not in fields or fields[name] in (None, ""):
            if f.get("required"):
                errors.append(f"field {name!r} is required")
            continue
        value, kind = fields[name], f.get("type", "text")
        problem = type_error(value, kind, f)
        if problem:
            errors.append(f"field {name!r} {problem}")
    return errors


def type_error(value, kind, spec):
    if kind == "text":
        if not isinstance(value, str):
            return "must be text"
        if MARKUP.search(value):
            return "holds markup; store text (Markdown inline code, bold, and links are allowed)"
    elif kind == "code":
        # Verbatim source (a diff, a config file, a command's output): stored as written, so `<` is data, not
        # markup. Views escape it and show it as a block.
        if not isinstance(value, str):
            return "must be text"
    elif kind == "number":
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            return "must be a number"
    elif kind == "datetime":
        try:
            parsed = datetime.fromisoformat(str(value))
        except ValueError:
            return f"must be an ISO 8601 date and time: {value!r}"
        if parsed.tzinfo is None:
            return f"needs a UTC offset, so every source merges into one zone: {value!r}"
    elif kind == "date":
        try:
            date.fromisoformat(str(value))
        except ValueError:
            return f"must be YYYY-MM-DD: {value!r}"
    elif kind == "url":
        if not isinstance(value, str) or not re.match(r"https?://", value):
            return f"must be an http(s) URL: {value!r}"
    elif kind == "enum":
        if value not in (spec.get("values") or []):
            return f"must be one of {', '.join(spec.get('values') or [])}: {value!r}"
    elif kind == "list":
        if not isinstance(value, list) or not all(isinstance(v, str) and not MARKUP.search(v) for v in value):
            return "must be a list of text"
    elif kind == "map":
        if not isinstance(value, dict) or not all(isinstance(v, str) for v in value.values()):
            return "must be an object of text values"
    else:
        return f"has unknown schema type {kind!r} (types: {', '.join(FIELD_TYPES)})"
    return None



VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"}
HIDDEN = {"script", "style", "head", "title", "template", "noscript"}


class ViewParser(HTMLParser):
    """Collects the stamp, every citation, and every visible number with its citations."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack = []  # (tag, cited keys, literal, hidden)
        self.meta = {}
        self.cited = set()
        self.numbers = []  # (text, keys, literal)

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == "meta" and (a.get("name") or "").startswith("fathom-"):
            self.meta[a["name"]] = a.get("content", "")
        if tag in VOID:
            return
        keys = set((a.get("data-fact") or "").split())
        self.cited |= keys
        parent = self.stack[-1] if self.stack else ("", frozenset(), False, False)
        self.stack.append((tag, parent[1] | keys, parent[2] or "data-literal" in a, parent[3] or tag in HIDDEN))

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        if tag not in VOID and self.stack:
            self.stack.pop()

    def handle_endtag(self, tag):
        for i in range(len(self.stack) - 1, -1, -1):
            if self.stack[i][0] == tag:
                del self.stack[i:]
                return

    def handle_data(self, data):
        _, keys, literal, hidden = self.stack[-1] if self.stack else ("", frozenset(), False, False)
        if hidden:
            return
        text = " ".join(data.split())
        if DIGITS.search(text):
            self.numbers.append((text, keys, literal))


def digit_runs(text):
    return {int(d) for d in DIGITS.findall(THOUSANDS.sub("", text))}


def row_runs(row):
    runs = set()

    def walk(v):
        if isinstance(v, dict):
            for x in v.values():
                walk(x)
        elif isinstance(v, list):
            for x in v:
                walk(x)
        elif v is not None and not isinstance(v, bool):
            s = str(v)
            runs.update(digit_runs(s))
            try:
                t = datetime.fromisoformat(s)
                runs.add(t.hour % 12 or 12)
            except ValueError:
                pass

    walk(row.get("fields"))
    return runs


def parse_view(view_path):
    parser = ViewParser()
    parser.feed(Path(view_path).read_text())
    return parser


def check(view_path, record):
    parser = parse_view(view_path)
    failures = []
    stamp = parser.meta.get("fathom-version")
    if not stamp or not stamp.isdigit():
        print(f"FAIL {view_path}: no <meta name=\"fathom-version\"> stamp", file=sys.stdout)
        return 3
    if not parser.meta.get("fathom-audience"):
        failures.append(("<head>", "no <meta name=\"fathom-audience\"> stamp"))
    visibility = parser.meta.get("fathom-visibility")
    if visibility not in VISIBILITY:
        failures.append(("<head>", f"no <meta name=\"fathom-visibility\"> stamp naming one of {', '.join(VISIBILITY)}"))
    version = int(stamp)
    facts = record.as_of(version)
    for key in sorted(parser.cited - set(facts)):
        failures.append((f'data-fact="{key}"', f"cites a fact the record doesn't hold as of v{version}"))
    unclassified = 0
    for key in sorted(parser.cited & set(facts)):
        level = facts[key].get("visibility")
        if level is None:
            unclassified += 1
        elif visibility in VISIBILITY and VISIBILITY.index(level) > VISIBILITY.index(visibility):
            failures.append((f'data-fact="{key}"', f"is {level}, narrower than this view's {visibility} visibility"))
    checked = literal = 0
    for text, keys, is_literal in parser.numbers:
        if is_literal:
            literal += 1
            continue
        checked += 1
        if not keys:
            failures.append((text, "states a number outside any citation"))
            continue
        held = set().union(*(row_runs(facts[k]) for k in keys if k in facts))
        missing = sorted(digit_runs(text) - held)
        if missing:
            failures.append((text, f"has {', '.join(map(str, missing))}, which none of {', '.join(sorted(keys))} holds as of v{version}"))
    for where, why in failures:
        print(f"FAIL {where}: {why}")
    verdict = "failed" if failures else "passed"
    print(f"{view_path}: {verdict}; v{version}, {parser.meta.get('fathom-audience', '?')}, {visibility or '?'} visibility, "
          f"{len(parser.cited)} facts cited ({unclassified} unclassified), {checked} numbers checked, "
          f"{literal} marked literal, {len(failures)} failures")
    # Passing says the view matches the record, not that the record is right, so
    # say how the cited facts are known: the reader of this line judges the rest.
    known = {c: sorted(k for k in parser.cited & set(facts) if facts[k].get("certainty") == c) for c in CERTAINTY}
    tally = ", ".join(f"{len(known[c])} {c}" for c in CERTAINTY)
    print(f"  cited facts are known as: {tally}" + (f"; inferred: {', '.join(known['inferred'])}" if known["inferred"] else ""))
    into = inbound(facts)
    for rel in ("contradicted by", "superseded by"):
        hit = [f"{k} ({', '.join(into[k][rel])})" for k in sorted(parser.cited & set(facts)) if into.get(k, {}).get(rel)]
        if hit:
            print(f"  cites facts {rel} others; say so or drop them: {', '.join(hit)}")
    return 3 if failures else 0



def cmd_init(args):
    d = record_dir(args.dir)
    if (d / "record.jsonl").exists():
        fail(f"{d} already holds a record")
    kind_chain(args.kind)
    d.mkdir(parents=True, exist_ok=True)
    root = records_root()
    if root.resolve() in d.resolve().parents and not (root / ".gitignore").exists():
        (root / ".gitignore").write_text("# fathom records stay out of commits until added on purpose (git add -f).\n*\n")
    append_jsonl(d / "record.jsonl", [{"seq": 0, "record": {"kind": args.kind, "title": args.title or (args.dir if NAME.match(args.dir) else d.name)}, "recorded": now()}])
    note_session(Record(args.dir), "init")
    print(f"{d}: new {args.kind} record, v0")


def cmd_add(args):
    record = Record(args.dir)
    text = sys.stdin.read().strip()
    if not text:
        fail("add reads rows from stdin: one row, or a list of rows, as YAML or JSON")
    try:
        data = yaml.safe_load(text)
    except yaml.YAMLError as e:
        fail(f"stdin is not YAML or JSON: {e}")
    rows = data if isinstance(data, list) else [data]
    if not all(isinstance(r, dict) for r in rows):
        fail("each row must be a mapping with key, type, certainty, basis, and fields")
    record.append([as_text(r) for r in rows])


def content(row):
    """What a row says, apart from who may read it: a classify row says nothing new."""
    return row.get("fields"), row.get("certainty"), row.get("relates"), bool(row.get("retracted"))


def written_at(record, key, version):
    """The version where a key's current content was written, looking past rows that only reclassified it."""
    rows = [r for r in record.rows if r["key"] == key and r["seq"] <= version]
    seq = rows[-1]["seq"]
    for r in reversed(rows[:-1]):
        if content(r) != content(rows[-1]):
            break
        seq = r["seq"]
    return seq


def inbound(facts):
    """For each fact, the current facts relating to it: {key: {"superseded by": [k, ...], ...}}."""
    out = {}
    for key, row in facts.items():
        for rel, targets in (row.get("relates") or {}).items():
            for t in targets:
                if t in facts and rel in INVERSE:
                    out.setdefault(t, {}).setdefault(INVERSE[rel], []).append(key)
    return out


def relation_line(row, into):
    parts = [f"{rel} {', '.join(keys)}" for rel, keys in (row.get("relates") or {}).items() if keys]
    parts += [f"{rel} {', '.join(keys)}" for rel, keys in into.items()]
    return "; ".join(parts)


def lede_state(record, version=None):
    """The lede as of a version, the version it was written at, why it is stale, and the facts changed since."""
    version = record.version if version is None else version
    facts = record.as_of(version)
    lede = facts.get(LEDE)
    if lede is None:
        return None, None, [], 0
    base = written_at(record, LEDE, version)
    then = record.as_of(base)
    into = inbound(facts)
    stale = []
    for key in lede["fields"].get("rests-on") or []:
        now_row = facts.get(key)
        if now_row is None:
            stale.append(f"{key} was retracted")
        elif key not in then or content(then[key]) != content(now_row):
            stale.append(f"{key} changed at v{written_at(record, key, version)}")
        for rel in ("superseded by", "contradicted by"):
            if into.get(key, {}).get(rel):
                stale.append(f"{key} is {rel} {', '.join(into[key][rel])}")
    since, said = 0, {}
    for r in record.rows:
        if r["seq"] > version:
            break
        if r["seq"] > base and said.get(r["key"]) != content(r):
            since += 1  # a classify row says nothing new, so it doesn't count
        said[r["key"]] = content(r)
    return lede, base, stale, since


def cmd_show(args):
    record = Record(args.dir)
    version = record.version if args.as_of is None else args.as_of
    lede, base, stale, since = lede_state(record, version)
    facts = {k: r for k, r in record.as_of(version).items() if k != LEDE}
    if args.type:
        facts = {k: r for k, r in facts.items() if r["type"] == args.type}
    meta = record.meta(version)
    if args.full:
        out = {"version": version, "kind": meta["kind"], "title": meta.get("title")}
        if lede:
            out["lede"] = {**lede, "written-at": base, "stale": stale, "changes-since": since}
        if args.cited:
            cites = cited_by(record)
            out["cited-by"] = {k: cites[k] for k in facts if k in cites}
        into = inbound(record.as_of(version))
        if any(k in into for k in facts):
            out["related-by"] = {k: into[k] for k in facts if k in into}
        print(dump({**out, "facts": list(facts.values())}), end="")
        return
    print(f"{meta.get('title')} ({meta['kind']}) as of v{version}: {len(facts)} facts")
    if lede:
        state = f"stale: {'; '.join(stale)}" if stale else "current"
        print(f"lede  [v{base}, {state}, {since} fact {'change' if since == 1 else 'changes'} since]  {lede['fields']['statement']}")
        print(f"  rests on: {', '.join(lede['fields']['rests-on'])}")
    else:
        print("lede  none yet: the record's bottom line, written by /fathom:record")
    cites = cited_by(record) if args.cited else {}
    into = inbound(record.as_of(version))
    for r in sorted(facts.values(), key=lambda r: (r["type"], r["key"])):
        print(f"  {r['key']}  [{r['type']}, {r['certainty']}, {r.get('visibility', 'unclassified')}, v{r['seq']}]  {yaml.safe_dump(r['fields'], default_flow_style=True, width=10**6, allow_unicode=True).strip()}")
        related = relation_line(r, into.get(r["key"], {}))
        if related:
            print(f"    {related}")
        if args.cited:
            print(f"    cited by: {', '.join(cites.get(r['key'], [])) or 'no saved view'}")


def cited_by(record):
    """For each fact key, the saved views whose latest render cites it: what a retraction would make stale."""
    log, out = renders(record), {}
    for name in dict.fromkeys(r["view"] for r in log if r["event"] == "rendered"):
        path = record.dir / latest_render(log, name)["file"]
        for key in parse_view(path).cited if path.exists() else ():
            out.setdefault(key, []).append(name)
    return out


def cmd_classify(args):
    record = Record(args.dir)
    with record.writing():  # copy each fact as it stands under the lock, so a concurrent correction isn't undone
        facts = record.as_of()
        missing = [k for k in args.keys if k not in facts]
        if missing:
            fail(f"the record holds no current fact {', '.join(map(repr, missing))}")
        rows = []
        for key in args.keys:
            row = {k: v for k, v in facts[key].items() if k in ("key", "type", "certainty", "basis", "fields")}
            rows.append({**row, "visibility": args.visibility})
        record.append(rows)


def cmd_history(args):
    record = Record(args.dir)
    rows = [r for r in record.rows if r["key"] == args.key]
    if not rows:
        fail(f"the record has no rows for {args.key!r}")
    print(dump(rows), end="")


def cmd_version(args):
    print(Record(args.dir).version)


def cmd_retitle(args):
    record = Record(args.dir)
    with record.writing():
        if record.meta().get("title") == args.title:
            fail(f"the record is already titled {args.title!r}")
        print(f"v{record.stamp([{'record': {'title': args.title}}])[0]['seq']} title: {args.title}")


def cmd_kind(args):
    chain = kind_chain(args.name) if args.name else Record(args.dir).chain
    print("kind: " + " -> ".join(f"{k} ({d})" for k, d, _ in chain))
    print("facts:")
    for name, spec in sorted(fact_types(chain).items()):
        fields = ", ".join(f"{f}{'*' if s.get('required') else ''}:{s.get('type', 'text')}" for f, s in (spec.get("fields") or {}).items())
        print(f"  {name}: {spec.get('about', '')}\n    {fields}")
    for sub in ("briefs", "framing"):
        names = listed(chain, sub)
        print(f"{sub}: " + (", ".join(f"{n} ({k})" for n, k in sorted(names.items())) or "none"))
    broken = []
    for name in sorted(listed(chain, "briefs")):
        try:
            parse_front_matter(find_in_chain(chain, "briefs", name)[2])
        except BriefError as e:
            broken.append(str(e))
    for problem in broken:
        print(f"broken brief: {problem}")
    sources = [str(d / "sources.md") for _, d, _ in reversed(chain) if (d / "sources.md").is_file()]
    print("sources: " + (", ".join(sources) or "none"))
    return 1 if broken else 0


def resolved_brief(chain, name):
    """The brief, every brief it extends, and every framing rule they name, as one text."""
    i, kind, path = find_in_chain(chain, "briefs", name)
    if not path:
        fail(f"no brief {name!r}; this kind has: {', '.join(sorted(listed(chain, 'briefs'))) or 'none'}")
    meta, _ = front_matter(path)
    missing = [k for k in ("audience", "visibility", "needs", "bottom-line", "tone", "leaves-out") if not meta.get(k)]
    if missing:
        fail(f"{path} is missing {', '.join(missing)} in its front matter")
    if meta["visibility"] not in VISIBILITY:
        fail(f"{path} names visibility {meta['visibility']!r}; use one of {', '.join(VISIBILITY)}")
    framing, current = list(meta.get("framing") or []), meta
    parts = [f"# brief: {name} ({kind}) {path}\n\n{path.read_text()}"]
    while current.get("extends") is True:
        i, kind, path = find_in_chain(chain, "briefs", name, i + 1)
        if not path:
            fail(f"brief {name!r} extends a brief of the same name, which no base kind has")
        current, body = front_matter(path)
        framing += [r for r in current.get("framing") or [] if r not in framing]
        parts.append(f"\n# extended brief: {name} ({kind}) {path}\n\n{body}")
    for rule in framing:
        _, rkind, rpath = find_in_chain(chain, "framing", rule)
        if not rpath:
            fail(f"brief {name!r} names framing rule {rule!r}, which this kind lacks")
        parts.append(f"\n# framing: {rule} ({rkind}) {rpath}\n\n{rpath.read_text()}")
    return "\n".join(parts)


def brief_digest(chain, name):
    """Paths vary by machine; the digest covers only the text a render follows."""
    text = resolved_brief(chain, name)
    return digest(re.sub(r"^# (brief|extended brief|framing): .*$", "", text, flags=re.M))


def style_digest(style):
    files = sorted((PLUGIN_ROOT / "skills/render/styles").glob(f"{style}.*")) if style else []
    return digest("".join(f.read_text() for f in files)) if files else None


def cmd_brief(args):
    chain = Record(args.dir).chain if args.dir else kind_chain(args.kind)
    print(resolved_brief(chain, args.name))


def cmd_check(args):
    return check(args.view, Record(args.record))


def renders(record):
    log = record.views / "renders.jsonl"
    return read_jsonl(log) if log.exists() else []


def cmd_save(args):
    record = Record(args.record)
    src = Path(args.view)
    if not src.is_file():
        fail(f"no view at {src}")
    status = check(src, record)
    if status:
        print(f"fathom: saved nothing: {src} fails its check", file=sys.stderr)
        return status
    stamps = parse_view(src).meta
    version, brief = int(stamps["fathom-version"]), stamps["fathom-audience"]
    style = args.style or stamps.get("fathom-style") or None
    name = args.name or brief
    if not KEY.match(name):
        fail(f"view name {name!r} must be lowercase letters, digits, and hyphens")
    # Everything that can fail runs before anything is written: a file in views/
    # without its renders.jsonl row is a render that `views` and `publish` can't see.
    digests = brief_digest(record.chain, brief), style_digest(style)
    log = renders(record)
    folder = record.views / name
    content, n = src.read_bytes(), 1
    while True:
        dest = folder / f"v{version}{'' if n == 1 else f'-{n}'}{src.suffix}"
        if not dest.exists() or dest.read_bytes() == content:
            break
        n += 1
    rel = str(dest.relative_to(record.dir))
    if dest.exists() and any(r["event"] == "rendered" and r["view"] == name and r["file"] == rel for r in log):
        print(f"{rel}: unchanged; already saved")
        return 0
    row = {"n": len(log) + 1, "event": "rendered", "at": now(), "view": name, "file": rel, "version": version,
           "brief": brief, "brief-digest": digests[0], "style": style, "style-digest": digests[1],
           "format": {".md": "markdown"}.get(src.suffix, src.suffix.lstrip(".")), "visibility": stamps["fathom-visibility"]}
    repaired = dest.exists()  # left by an earlier save that failed after copying; log it now
    if not repaired:
        folder.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dest)
    try:
        append_jsonl(record.views / "renders.jsonl", [row])
    except OSError as e:
        if not repaired:
            dest.unlink(missing_ok=True)
        fail(f"saved nothing: could not log the render: {e}")
    print(f"{rel}: {'logged a render an earlier save left unlogged' if repaired else 'saved'}, render {row['n']}")
    return 0


def latest_render(log, name):
    found = [r for r in log if r["event"] == "rendered" and r["view"] == name]
    if not found:
        fail(f"no saved view named {name!r}; `fathom views` lists them")
    return found[-1]


def cmd_publish(args):
    record = Record(args.record)
    log = renders(record)
    render = latest_render(log, args.view)
    if args.file:
        render = next((r for r in log if r["event"] == "rendered" and r["file"] == args.file), None) or \
            fail(f"no saved render at {args.file}")
    row = {"n": len(log) + 1, "event": "published", "at": now(), "view": render["view"], "file": render["file"],
           "render": render["n"], "to": args.to}
    append_jsonl(record.views / "renders.jsonl", [row])
    print(f"{render['file']}: published to {args.to}")


def staleness(record, render):
    """What moved since the render: cited facts, the brief, the style."""
    reasons = []
    path = record.dir / render["file"]
    if path.exists():
        then, latest = record.as_of(render["version"]), record.as_of()
        cited = parse_view(path).cited
        moved = sorted(k for k in cited if (then.get(k) or {}).get("seq") != (latest.get(k) or {}).get("seq"))
        if moved:
            reasons.append(f"{len(moved)} cited facts changed since v{render['version']}: {', '.join(moved)}")
        if LEDE in cited:
            _, _, stale, _ = lede_state(record)
            if stale:
                reasons.append(f"the lede it opens with is stale ({'; '.join(stale)}); revise the lede before rendering again")
    else:
        reasons.append(f"{render['file']} is missing")
    if find_in_chain(record.chain, "briefs", render["brief"])[2] is None:
        reasons.append(f"brief {render['brief']!r} no longer exists")
    elif brief_digest(record.chain, render["brief"]) != render["brief-digest"]:
        reasons.append(f"brief {render['brief']!r} changed")
    if render.get("style-digest") and style_digest(render["style"]) != render["style-digest"]:
        reasons.append(f"style {render['style']!r} changed")
    return reasons


def cmd_views(args):
    record = Record(args.record)
    log = renders(record)
    names = list(dict.fromkeys(r["view"] for r in log if r["event"] == "rendered"))
    if not names:
        print(f"no saved views; record at v{record.version}")
        return 0
    stale = 0
    for name in names:
        r = latest_render(log, name)
        published = [p["to"] for p in log if p["event"] == "published" and p["render"] == r["n"]]
        reasons = staleness(record, r)
        stale += bool(reasons)
        print(f"{name}  {r['file']}  [v{r['version']}, {r['brief']}, {r.get('style') or 'no named style'}, {r['visibility']}]"
              f"  {'stale' if reasons else 'current'}")
        for p in published:
            print(f"  published to {p}")
        for why in reasons:
            print(f"  {why}")
    print(f"{len(names)} views, {stale} stale; record at v{record.version}")
    return 0


def cmd_compact(args):
    """What a compaction pass can find mechanically; deciding a fact is wrong takes the session's judgment."""
    record = Record(args.dir)
    facts = record.as_of()
    print(f"{record.meta().get('title')}: {len(facts)} current facts from {len(record.rows)} rows, v{record.version}")
    found = 0
    same = {}
    for key, row in facts.items():
        if key != LEDE:
            same.setdefault((row["type"], json.dumps(row["fields"], sort_keys=True)), []).append(key)
    for (ftype, _), keys in sorted(same.items(), key=lambda kv: kv[1]):
        if len(keys) > 1:
            found += 1
            print(f"duplicate  {ftype} {', '.join(sorted(keys))}: identical fields; keep one, retract the rest with a basis naming it")
    into = inbound(facts)
    by = {}
    for key, rels in into.items():
        for newer in rels.get("superseded by", []):
            by.setdefault(newer, []).append(key)
    for newer, old in sorted(by.items()):
        found += 1
        print(f"superseded by {newer}: {', '.join(sorted(old))}: a theme to offer as no longer relevant, weighed against the briefs that need it")
    seen = set()
    for key, rels in sorted(into.items()):
        for other in rels.get("contradicted by", []):
            pair = tuple(sorted((key, other)))
            if pair not in seen:
                seen.add(pair)
                found += 1
                print(f"contradiction  {other} contradicts {key}: settle it with evidence, or keep both and say so in every view citing either")
    lede, base, stale, since = lede_state(record)
    if lede is None:
        found += 1
        print("lede       none: write one from the facts that hold")
    elif stale:
        found += 1
        print(f"lede       stale ({'; '.join(stale)}): confirm it or revise it, repointing rests-on at surviving keys")
    elif since:
        print(f"lede       current; {since} fact {'change' if since == 1 else 'changes'} since v{base}: confirm it still holds")
    print(f"{found} mechanical {'finding' if found == 1 else 'findings'}; wrong facts and differently worded duplicates "
          f"are the user's call (/fathom:compact)")
    return 0


def cmd_touched(args):
    """The records a Claude session wrote, latest write last, one directory per line."""
    session = args.session or os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not session or not re.fullmatch(r"[A-Za-z0-9-]+", session):
        fail("touched needs --session <id> or CLAUDE_CODE_SESSION_ID")
    path = ledger_path(session)
    last = {}
    for row in read_jsonl(path) if path.exists() else []:
        last.pop(row["record"], None)
        last[row["record"]] = row
    for record, row in last.items():
        if (Path(record) / "record.jsonl").is_file():
            print(f"{record}  v{row['version']}" if args.verbose else record)
    return 0


FATHOM_HOOKS = ("/hooks/tack.sh", "/hooks/after-compact.sh")  # pre-compact's output goes to the summary, not the context
FATHOM_CALL = re.compile(r"(^|[\s/;&|(])fathom(\s|$)")


def cmd_metrics(args):
    """What fathom cost a session: time from the CLI's own log, tokens from the session's transcript."""
    timings = [r for r in read_jsonl(state_dir() / "timings.jsonl")] if (state_dir() / "timings.jsonl").exists() else []
    session = args.session or os.environ.get("CLAUDE_CODE_SESSION_ID")
    if session:
        timings = [r for r in timings if r.get("session") == session]
    by = {}
    for r in timings:
        by.setdefault(r["command"], []).append(r["ms"])
    print(f"CLI time{' for session ' + session if session else ''}: {len(timings)} runs, "
          f"{sum(sum(v) for v in by.values()) / 1000:.1f} s in process (each run also pays about 0.1 s to start)")
    for command, ms in sorted(by.items(), key=lambda kv: -sum(kv[1])):
        ms = sorted(ms)
        print(f"  {command:10} {len(ms):4} runs  median {ms[len(ms) // 2]:5} ms  max {ms[-1]:5} ms")
    if not args.transcript:
        return 0
    path = Path(args.transcript).expanduser()
    if not path.is_file():
        fail(f"no transcript at {path}")
    requests, order, calls, results, tools = {}, [], {}, {}, {}
    hooks = {"chars": 0, "runs": 0, "ms": []}
    for line in path.read_text().splitlines():
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        msg = d.get("message") or {}
        if d.get("type") == "assistant" and msg.get("usage"):
            rid = d.get("requestId") or d.get("uuid")
            if rid not in requests:
                order.append(rid)
            requests[rid] = msg["usage"]
            for block in msg.get("content") or []:
                if block.get("type") != "tool_use":
                    continue
                tools[rid] = tools.get(rid, 0) + 1
                inp = block.get("input") or {}
                if (block.get("name") == "Bash" and FATHOM_CALL.search(inp.get("command", ""))) or \
                        (block.get("name") == "Skill" and str(inp.get("skill", "")).lstrip("/").startswith("fathom:")):
                    calls[block["id"]] = rid
        elif d.get("type") == "user" and isinstance(msg.get("content"), list):
            for block in msg["content"]:
                if block.get("type") == "tool_result" and block.get("tool_use_id") in calls:
                    content = block.get("content")
                    text = content if isinstance(content, str) else json.dumps(content)
                    results[block["tool_use_id"]] = (len(order), len(text))
        elif d.get("type") == "attachment":
            att = d.get("attachment") or {}
            if str(att.get("command", "")).rstrip('"').endswith(FATHOM_HOOKS):
                hooks["runs"] += 1
                hooks["ms"].append(int(att.get("durationMs") or 0))
                text = str(att.get("content") or "")
                if text.startswith(("fathom", "This session kept fathom")):
                    hooks["chars"] += len(text)
    total_out = sum(u.get("output_tokens", 0) for u in requests.values())
    total_in = sum(u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0) + u.get("cache_creation_input_tokens", 0)
                   for u in requests.values())
    # A request that made several tool calls is charged to fathom only for its fathom calls' share.
    fathom_out = sum(requests[rid].get("output_tokens", 0) / tools[rid] for rid in calls.values())
    added = sum(n for _, n in results.values()) / 4  # about four characters a token
    carried = sum(n / 4 * (len(order) - at) for at, n in results.values())  # each result is re-read by every later request
    print(f"tokens in {path.name}: {len(order)} requests, {total_in:,} input (cached included), {total_out:,} output")
    print(f"  fathom calls        {len(calls)} (CLI and fathom skills)")
    print(f"  output writing them about {fathom_out:,.0f} tokens ({fathom_out / max(total_out, 1):.0%} of output)")
    print(f"  results they added  about {added:,.0f} tokens, re-read by later requests for about {carried:,.0f} "
          f"({carried / max(total_in, 1):.0%} of input)")
    ms = sorted(hooks["ms"]) or [0]
    print(f"  hooks               {hooks['runs']} runs, median {ms[len(ms) // 2]} ms, max {ms[-1]} ms; "
          f"context they added about {hooks['chars'] / 4:,.0f} tokens")
    return 0


def build_parser():
    p = argparse.ArgumentParser(prog="fathom", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init", help="start a record of a kind")
    s.add_argument("dir", help="a bare name for .fathom/<name> at the repo root, or a path")
    s.add_argument("--kind", required=True)
    s.add_argument("--title")
    s.set_defaults(func=cmd_init)

    s = sub.add_parser("add", help="validate rows from stdin and append them; all or nothing")
    s.add_argument("dir")
    s.set_defaults(func=cmd_add)

    s = sub.add_parser("show", help="the facts as of a version")
    s.add_argument("dir")
    s.add_argument("--as-of", type=int)
    s.add_argument("--type")
    s.add_argument("--full", action="store_true", help="every field of every row, as YAML")
    s.add_argument("--cited", action="store_true", help="the saved views citing each fact: what retracting it would make stale")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("classify", help="set who may read facts, as a new row of each")
    s.add_argument("dir")
    s.add_argument("visibility", choices=VISIBILITY)
    s.add_argument("keys", nargs="+", metavar="key")
    s.set_defaults(func=cmd_classify)

    s = sub.add_parser("history", help="every row for one key")
    s.add_argument("dir")
    s.add_argument("key")
    s.set_defaults(func=cmd_history)

    s = sub.add_parser("version", help="the record's latest version")
    s.add_argument("dir")
    s.set_defaults(func=cmd_version)

    s = sub.add_parser("retitle", help="give the record a new title, as a new version")
    s.add_argument("dir")
    s.add_argument("title")
    s.set_defaults(func=cmd_retitle)

    s = sub.add_parser("kind", help="a kind's fact types, briefs, framing rules, and sources")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("dir", nargs="?")
    g.add_argument("--name")
    s.set_defaults(func=cmd_kind)

    s = sub.add_parser("brief", help="print a brief and the framing rules it names")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--record", dest="dir")
    g.add_argument("--kind")
    s.add_argument("name")
    s.set_defaults(func=cmd_brief)

    s = sub.add_parser("check", help="check a rendered HTML view against the record")
    s.add_argument("view")
    s.add_argument("--record", required=True)
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("save", help="check a view, keep it in the record's views/, and log its inputs")
    s.add_argument("view")
    s.add_argument("--record", required=True)
    s.add_argument("--name", help="the view's name; defaults to its brief")
    s.add_argument("--style", help="the named style; defaults to the fathom-style stamp")
    s.set_defaults(func=cmd_save)

    s = sub.add_parser("publish", help="log where a saved view was published")
    s.add_argument("view", help="the view's name")
    s.add_argument("--record", required=True)
    s.add_argument("--to", required=True, help="where it went: a URL, a channel, a list")
    s.add_argument("--file", help="a saved render other than the view's latest, as views/<name>/v<N>.html")
    s.set_defaults(func=cmd_publish)

    s = sub.add_parser("compact", help="what a compaction pass can find mechanically: duplicates and a stale lede")
    s.add_argument("dir")
    s.set_defaults(func=cmd_compact)

    s = sub.add_parser("metrics", help="what fathom cost: CLI time, and tokens in a session's transcript")
    s.add_argument("--session", help="limit CLI time to one session; defaults to CLAUDE_CODE_SESSION_ID")
    s.add_argument("--transcript", help="a Claude Code transcript (.jsonl) to attribute tokens from")
    s.set_defaults(func=cmd_metrics)

    s = sub.add_parser("touched", help="the records a Claude session wrote to")
    s.add_argument("--session", help="the session id; defaults to CLAUDE_CODE_SESSION_ID")
    s.add_argument("-v", "--verbose", action="store_true", help="add the version each record reached")
    s.set_defaults(func=cmd_touched)

    s = sub.add_parser("views", help="each saved view's latest render, and what has moved since")
    s.add_argument("record")
    s.set_defaults(func=cmd_views)
    return p


def main(argv):
    if argv[:1] == ["help"]:
        argv = ["--help"]
    parser = build_parser()
    if not argv:
        parser.print_help(sys.stderr)
        return 2
    args = parser.parse_args(argv)
    started, status = time.monotonic(), 1
    try:
        status = args.func(args) or 0
        return status
    except SystemExit as e:
        status = e.code if isinstance(e.code, int) else 1
        raise
    finally:
        if args.cmd != "metrics":
            log_timing(args.cmd, started, status)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
